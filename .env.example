# Optional environment overrides for the MuninnDB memory provider.
# Names only: put real values in $HERMES_HOME/.env or your shell, never in Git.
# An unset or empty value falls back to $HERMES_HOME/muninndb.json, then to the
# existing Muninn MCP server entry in Hermes config.yaml.

# MuninnDB MCP endpoint URL. MUNINN_MCP_URL takes precedence over MUNINN_ENDPOINT.
MUNINN_MCP_URL=
MUNINN_ENDPOINT=

# Optional MCP bearer token. Leave blank for unsecured/default-vault setups.
MUNINN_MCP_TOKEN=

# MuninnDB vault name. Falls back to "default" when unset everywhere.
MUNINN_VAULT=
